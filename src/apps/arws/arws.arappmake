ALRIGROUP@APPMAKE
{
  "name": "arws",
  "bin": "arws.arapp",
  "version": "1.0.0",
  "runtime": "native",
  "entry": "libarws.arlib",
  "services": [
    {"name": "arws", "entry": "arws_entry"}
  ],
  "build": {
    "staging": "$ARCORE/.staging/$APP_NAME",
    "steps": [
      {
        "name": "cc",
        "cmd": "gcc -shared -fPIC -O2 -I. -I../../ALRIOS/core -I../../ALRIOS/arkernel/include -I../../ALRIOS/arkernel/ipc -I../../ALRIOS/arkernel/os/include -o $STAGING/libarws.arlib arws_entry.c arws_gateway.c arws_utils.c arws_config.c arws_ratelimit.c arws_session.c arws_cache.c arws_proxy.c arws_stream_proxy.c arws_upstream.c arws_health.c modes.c router_ex.c registry.c dispatcher.c server.c cJSON.c -L$ARCORE/lib -larkernel -lssl -lcrypto -lpthread"
      }
    ]
  },
  "files": ["libarws.arlib", "web/404/index.html", "web/maintenance/index.html"]
}
