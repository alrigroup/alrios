ALRIGROUP@APPMAKE
{
  "name": "arapibus",
  "bin": "arapibus.arapp",
  "version": "1.0.0",
  "runtime": "native",
  "entry": "arapibus",
  "platforms": {
    "windows": {"entry": "arapibus"},
    "linux": {"entry": "arapibus"},
    "linux-x64": {"entry": "arapibus"},
    "linux-arm64": {"entry": "arapibus"}
  },
  "build": {
    "staging": "$ARCORE/.staging/$APP_NAME",
    "steps": [
      {
        "name": "cc",
        "cmd": "gcc -O2 -I. -I../../ALRIOS/core -I../../ALRIOS/arkernel/include -I../../ALRIOS/arkernel/os/include -o $STAGING/arapibus arapibus_entry.c arapibus_config.c arapibus_db.c arapibus_http.c -L$ARCORE/lib -larkernel -lssl -lcrypto -lpthread"
      }
    ]
  },
  "files": [
    "arapibus",
    "arapibus.cfg"
  ]
}
