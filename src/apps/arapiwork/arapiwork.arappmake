ALRIGROUP@APPMAKE
{
  "name": "arapiwork",
  "bin": "arapiwork.arapp",
  "version": "1.0.0",
  "runtime": "native",
  "entry": "arapiwork",
  "platforms": {
    "windows": {"entry": "arapiwork"},
    "linux": {"entry": "arapiwork"},
    "linux-x64": {"entry": "arapiwork"},
    "linux-arm64": {"entry": "arapiwork"}
  },
  "build": {
    "staging": "$ARCORE/.staging/$APP_NAME",
    "steps": [
      {
        "name": "cc",
        "cmd": "gcc -O2 -I. -I../../ALRIOS/core -I../../ALRIOS/arkernel/include -I../../ALRIOS/arkernel/os/include -o $STAGING/arapiwork arapiwork_entry.c arapiwork_config.c arapiwork_http.c -L$ARCORE/lib -larkernel -lssl -lcrypto -lpthread"
      }
    ]
  },
  "files": [
    "arapiwork",
    "arapiwork.cfg"
  ]
}
