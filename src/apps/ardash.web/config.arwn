# Configuracao ARWN para ardash.web (BI & Analytics)
[app]
name=ardash-web
port=3015
bind=127.0.0.1
copyright=/*Copyright (c) 2026 ALRIGROUP. All rights reserved.*/

[arws]
gateway=127.0.0.1:9500
route.host=ardash.alrigroup.com, ardash.localhost, test-ardash.alrigroup.com
route.path=/*
route.mode=production

[unit:main]
source=web/dist/
entry=main.arhtml
route=/
compile=main.js
compile.lang=js
obfuscate=yes
copyright=`/*
========================================================================
THIRD-PARTY NOTICES AND LICENSES
========================================================================

1. React / React DOM (MIT License) - Meta Platforms, Inc.
========================================================================
*/`
