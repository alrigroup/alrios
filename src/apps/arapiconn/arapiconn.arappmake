ALRIGROUP@APPMAKE
{
  "name": "arapiconn",
  "bin": "arapiconn.arapp",
  "version": "1.0.0",
  "runtime": "native",
  "entry": "arapiconn",
  "platforms": {
    "windows": {"entry": "arapiconn"},
    "linux": {"entry": "arapiconn"},
    "linux-x64": {"entry": "arapiconn"},
    "linux-arm64": {"entry": "arapiconn"}
  },
  "build": {
    "staging": "$ARCORE/.staging/$APP_NAME",
    "steps": [
      {
        "name": "cc",
        "cmd": "gcc -O2 -I. -I../../ALRIOS/core -I../../ALRIOS/arkernel/include -I../../ALRIOS/arkernel/os/include -o $STAGING/arapiconn arapiconn_entry.c arapiconn_config.c arapiconn_db.c arapiconn_http.c -L$ARCORE/lib -larkernel -lssl -lcrypto -lpthread"
      }
    ]
  },
  "files": [
    "arapiconn",
    "arapiconn.cfg"
  ]
}
