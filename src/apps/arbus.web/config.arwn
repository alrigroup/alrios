# Configuracao ARWN para arbus.web (Gestao Corporativa)
[app]
name=arbus-web
port=3013
bind=127.0.0.1
copyright=/*Copyright (c) 2026 ALRIGROUP. All rights reserved.*/

[arws]
gateway=127.0.0.1:9500
route.host=arbus.alrigroup.com, arbus.localhost, test-arbus.alrigroup.com
route.path=/*
route.mode=production

[unit:main]
source=web/dist/
entry=main.arhtml
route=/
compile=main.js
compile.lang=js
obfuscate=yes
copyright=`/*
========================================================================
THIRD-PARTY NOTICES AND LICENSES
========================================================================

1. React / React DOM (MIT License) - Meta Platforms, Inc.
========================================================================
*/`
