ALRIGROUP@APPMAKE
{
  "name": "arapichat",
  "bin": "arapichat.arapp",
  "version": "1.0.0",
  "runtime": "native",
  "entry": "arapichat",
  "platforms": {
    "windows": {"entry": "arapichat"},
    "linux": {"entry": "arapichat"},
    "linux-x64": {"entry": "arapichat"},
    "linux-arm64": {"entry": "arapichat"}
  },
  "build": {
    "staging": "$ARCORE/.staging/$APP_NAME",
    "steps": [
      {
        "name": "cc",
        "cmd": "gcc -O2 -I. -I../../ALRIOS/core -I../../ALRIOS/arkernel/include -I../../ALRIOS/arkernel/os/include -o $STAGING/arapichat arapichat_entry.c arapichat_config.c arapichat_db.c arapichat_http.c -L$ARCORE/lib -larkernel -lssl -lcrypto -lpthread"
      }
    ]
  },
  "files": [
    "arapichat",
    "arapichat.cfg"
  ]
}
