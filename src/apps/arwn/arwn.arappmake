ALRIGROUP@APPMAKE
{
  "name": "arwn",
  "bin": "arwn.arapp",
  "version": "0.2.0",
  "runtime": "native",
  "entry": "arwn_build",
  "platforms": {
    "windows": {"entry": "arwn_build.exe"},
    "linux": {"entry": "arwn_build"},
    "linux-x64": {"entry": "arwn_build"},
    "linux-arm64": {"entry": "arwn_build"}
  },
  "build": {
    "staging": "$ARCORE/.staging/$APP_NAME",
    "steps": [
      {
        "name": "cc",
        "cmd": "gcc -O2 -I. -Iinclude -Icore -I../../ALRIOS/arkernel/include -I../../ALRIOS/arkernel/os/include -o $STAGING/arwn_build tools/arwn_build.c core/arwn_core.c core/arwn_server.c core/arwn_http.c core/arwn_gateway.c core/arwn_builder.c core/arwn_obfuscator.c core/arwn_pack.c core/arwn_config.c -L$ARCORE/lib -larkernel -lssl -lcrypto && cp include/arwn.h $STAGING/arwn.h"
      }
    ]
  },
  "files": [
    "arwn_build",
    "arwn.h"
  ]
}