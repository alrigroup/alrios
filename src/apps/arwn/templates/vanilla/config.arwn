# Configuracao do app ARWN
[app]
name=meuapp
port=3001
bind=127.0.0.1

[arws]
gateway=127.0.0.1:9500
route.host=alrigroup.com
route.path=/*
route.mode=production

[unit:main]
source=web/
entry=index.arhtml
compile=main.js
compile.lang=js
obfuscate=yes

[assets]
dir=assets
obfuscate=no
cache=immutable