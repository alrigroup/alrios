ALRIGROUP@APPMAKE
{
  "name": "home-web",
  "bin": "home.web.arapp",
  "version": "1.0.0",
  "runtime": "native",
  "entry": "home.web.exe",
  "platforms": {
    "windows": {
      "entry": "home.web.exe"
    },
    "linux": {
      "entry": "home_web"
    },
    "linux-x64": {
      "entry": "home_web"
    },
    "linux-arm64": {
      "entry": "home_web"
    }
  },
  "build": {
    "staging": "$ARCORE/.staging/$APP_NAME",
    "steps": [
      {
        "name": "spa",
        "cmd": "node rebuild.mjs",
        "cwd": "web"
      },
      {
        "name": "arweb",
        "cmd": "$ARWN_BUILD build $APP_DIR --out $STAGING/build"
      }
    ],
    "cleanup": [
      "build",
      "web/dist"
    ]
  },
  "files": [
    "home_web",
    "config.arwn",
    "build/main.arweb",
    "robots.txt",
    "sitemap.xml"
  ]
}
