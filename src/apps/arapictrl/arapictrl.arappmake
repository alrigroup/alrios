ALRIGROUP@APPMAKE
{
  "name": "arapictrl",
  "bin": "arapictrl.arapp",
  "version": "1.0.0",
  "runtime": "native",
  "entry": "arapictrl",
  "platforms": {
    "windows": {"entry": "arapictrl"},
    "linux": {"entry": "arapictrl"},
    "linux-x64": {"entry": "arapictrl"},
    "linux-arm64": {"entry": "arapictrl"}
  },
  "build": {
    "staging": "$ARCORE/.staging/$APP_NAME",
    "steps": [
      {
        "name": "cc",
        "cmd": "gcc -O2 -I. -I../../ALRIOS/core -I../../ALRIOS/arkernel/include -I../../ALRIOS/arkernel/os/include -o $STAGING/arapictrl arapictrl_entry.c arapictrl_config.c arapictrl_db.c arapictrl_http.c -L$ARCORE/lib -larkernel -lssl -lcrypto -lpthread"
      }
    ]
  },
  "files": [
    "arapictrl",
    "arapictrl.cfg"
  ]
}
