ALRIGROUP@APPMAKE
{
  "name": "arcdn",
  "bin": "arcdn.arapp",
  "version": "1.0.0",
  "runtime": "native",
  "entry": "cdn_web",
  "platforms": {
    "windows": {"entry": "cdn_web"},
    "linux": {"entry": "cdn_web"},
    "linux-x64": {"entry": "cdn_web"},
    "linux-arm64": {"entry": "cdn_web"}
  },
  "build": {
    "staging": "$ARCORE/.staging/$APP_NAME",
    "steps": [
      {
        "name": "cc",
        "cmd": "cc -O2 -I. -Ios/include -I../../ALRIOS/arkernel/include -I../../ALRIOS/arkernel/os/include -I../../ALRIOS/arkernel/ipc -o $STAGING/cdn_web cdn_server.c os/main.c ../../ALRIOS/arkernel/os/main.c -lssl -lcrypto -lpthread"
      }
    ],
    "cleanup": []
  },
  "files": [
    "cdn_web"
  ]
}