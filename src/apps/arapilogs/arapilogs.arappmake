ALRIGROUP@APPMAKE
{
  "name": "arapilogs",
  "bin": "arapilogs.arapp",
  "version": "1.0.0",
  "runtime": "native",
  "entry": "arapilogs",
  "platforms": {
    "windows": {"entry": "arapilogs"},
    "linux": {"entry": "arapilogs"},
    "linux-x64": {"entry": "arapilogs"},
    "linux-arm64": {"entry": "arapilogs"}
  },
  "build": {
    "staging": "$ARCORE/.staging/$APP_NAME",
    "steps": [
      {
        "name": "cc",
        "cmd": "gcc -O2 -I. -I../../ALRIOS/core -I../../ALRIOS/arkernel/include -I../../ALRIOS/arkernel/os/include -o $STAGING/arapilogs arapilogs_entry.c arapilogs_config.c arapilogs_db.c arapilogs_http.c -L$ARCORE/lib -larkernel -lssl -lcrypto -lpthread"
      }
    ]
  },
  "files": [
    "arapilogs",
    "arapilogs.cfg"
  ]
}
