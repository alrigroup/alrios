# Build Directories & Residue
build/
build-linux/
.staging/
bin/
out/
Obj/
x64/
x86/
Debug/
Release/
*.dir/

# Executables, Libraries & Binaries in arcore output directory
arcore/
arcore/.staging/
arcore/apps/
arcore/programfiles/
arcore/run/
arcore/storage/
