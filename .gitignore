arcore/*.pid

# Object and Compiled Artifacts
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.exp
*.pdb
*.i
*.s

# Node.js & Web Dependencies / Bundles
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
dist/
.vite/

# Temp & Editor / IDE Files
.vs/
.vscode/
.idea/
# Storage & backups
storage/
storage.bak/
*.db
*.db.tmp
*.user
*.suo
*.userosv
*.sln.docstates
*.cache
*.tmp
*.bak
# Environment & Secrets Files
.env
.env.*
*.env
!.env.example

# Root Local Tool Symlink
/alrios



